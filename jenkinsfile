pipeline {
    agent any

    environment {
        // PATH = "/usr/local/bin:/usr/bin:/bin:${env.PATH}"
        DOCKER_IMAGE   = 'shahiddevksa/gs1-resolver'
        CONTAINER_NAME = 'gs1-resolver'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH}, Commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        stage('Check/Create Network') {
            steps {
                sh """
                    set -e

                    NETWORK_NAME=gs1-network

                    docker network inspect \$NETWORK_NAME >/dev/null 2>&1 || \
                    docker network create \$NETWORK_NAME

                    echo "Network ready: \$NETWORK_NAME"
                """
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([file(credentialsId: 'gs1resolverEnv', variable: 'ENV_FILE')]) {
                    sh """
                        echo "Using .env file from Jenkins credentials: \$ENV_FILE"

                        docker build \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'DockerHub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\${DOCKER_PASS}" | docker login -u "\${DOCKER_USER}" --password-stdin
                        docker push ${DOCKER_IMAGE}:latest
                        docker logout
                    """
                }
            }
        }

        stage('Deploy on Server') {
            steps {
                withCredentials([file(credentialsId: 'gs1resolverEnv', variable: 'ENV_FILE')]) {
                    sh """
                        docker stop ${CONTAINER_NAME} || true
                        docker rm ${CONTAINER_NAME} || true

                        docker run -d \
                            --name ${CONTAINER_NAME} \
                            --restart unless-stopped \
                            --network gs1-network \
                            -p 1091:1091 \
                            --env-file \$ENV_FILE \
                            ${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sh """
                    echo "Waiting for app to start..."
                    sleep 15
                    docker inspect --format='{{.State.Status}}' ${CONTAINER_NAME}
                    curl -f http://localhost:1091 > /dev/null 2>&1 \
                        && echo "App is UP and responding" \
                        || echo "App not responding yet - check manually"
                """
            }
        }

        stage('Cleanup') {
            steps {
                sh "docker image prune -f"
            }
        }
    }

    post {
        success {
            echo "DEPLOYMENT SUCCESSFUL - Build #${BUILD_NUMBER} live on port 1091"
        }
        failure {
            echo "DEPLOYMENT FAILED - Build #${BUILD_NUMBER} - check logs above"
            sh "docker start ${CONTAINER_NAME} || true"
        }
        always {
            echo "Pipeline finished - Build #${BUILD_NUMBER}"
        }
    }
}
