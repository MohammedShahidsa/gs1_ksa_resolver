pipeline {
    agent any

    environment {
        IMAGE_NAME = 'gs1-resolver'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH}, Commit: ${env.GIT_COMMIT?.take(7)}"
            }
        }

        stage('Check/Create Network') {
            steps {
                sh """
                    set -e

                    NETWORK_NAME=gs1-network

                    docker network inspect \$NETWORK_NAME >/dev/null 2>&1 || \
                    docker network create \$NETWORK_NAME

                    echo "Network ready: \$NETWORK_NAME"
                """
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([file(credentialsId: 'gs1resolverEnv', variable: 'ENV_FILE')]) {
                    withCredentials([usernamePassword(
                        credentialsId: 'DockerHub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "Using .env file from Jenkins credentials: \$ENV_FILE"

                            docker build \
                                -t ${IMAGE_NAME}:latest \
                                -t \$DOCKER_USER/${IMAGE_NAME}:latest \
                                -t \$DOCKER_USER/${IMAGE_NAME}:${IMAGE_TAG} \
                                .
                        """
                    }
                }
            }
        }

        stage('Run Smoke Test') {
            steps {
                sh """
                    docker rm -f ${IMAGE_NAME}-test 2>/dev/null || true

                    docker run -d \
                        --name ${IMAGE_NAME}-test \
                        -p 1091:1091 \
                        -e NPC_BASE=https://npc.gs1.org.sa \
                        ${IMAGE_NAME}:latest

                    sleep 5

                    curl -f -o /dev/null -s -w "%{http_code}" http://localhost:1091/ | grep -E "301|302"

                    docker rm -f ${IMAGE_NAME}-test
                """
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'DockerHub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                        docker push \$DOCKER_USER/${IMAGE_NAME}:${IMAGE_TAG}
                        docker push \$DOCKER_USER/${IMAGE_NAME}:latest

                        docker logout
                    """
                }
            }
        }

        stage('Deploy on Server') {
            steps {
                withCredentials([
                    file(credentialsId: 'gs1resolverEnv', variable: 'ENV_FILE'),
                    usernamePassword(
                        credentialsId: 'DockerHub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh """
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin

                        docker pull \$DOCKER_USER/${IMAGE_NAME}:latest

                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true

                        docker run -d \
                            --name ${IMAGE_NAME} \
                            --restart unless-stopped \
                            --network gs1-network \
                            -p 1091:1091 \
                            --env-file \$ENV_FILE \
                            \$DOCKER_USER/${IMAGE_NAME}:latest

                        docker logout
                    """
                }
            }
        }

        stage('Health Check') {
            steps {
                sh """
                    echo "Waiting for app to start..."
                    sleep 15

                    docker inspect --format='{{.State.Status}}' ${IMAGE_NAME}

                    curl -f http://localhost:1091 > /dev/null 2>&1 \
                        && echo "App is UP and responding" \
                        || (echo "App is not responding"; exit 1)
                """
            }
        }

        stage('Cleanup') {
            steps {
                sh """
                    docker image prune -f
                """
            }
        }
    }

    post {
        always {
            sh 'docker image prune -f || true'
        }

        success {
            echo "Build ${IMAGE_NAME}:${IMAGE_TAG} completed successfully."
        }

        failure {
            echo "Build failed."
        }
    }
}